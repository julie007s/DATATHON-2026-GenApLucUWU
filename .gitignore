**/*.pdf

# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyd

# ==========================================
# Virtual Environment
# ==========================================
.venv/
venv/
env/
ENV/
.env
.env.local
.env.*

# ==========================================
# Jupyter Notebook
# ==========================================
.ipynb_checkpoints/
*.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ==========================================
# Data Pipeline (Processes & Outputs)
# ==========================================
# Ignore processed data but keep the directory structure (via .gitkeep)
data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/output/*
!data/output/.gitkeep

data/quarantine/*
!data/quarantine/.gitkeep

# Specifically ignore large output files
master_table.csv
validation_report.csv
du_lieu_tong_hop.csv
bao_cao_kiem_dinh.csv

# Logs
*.log
data/logs/

# Raw data is NOT ignored by default for collaboration
# data/raw/

